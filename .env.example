# Local development values only. Never add real secrets here.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://handoffproof:handoffproof@localhost:5432/handoffproof
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated Fernet keys for connector credentials (first encrypts, all decrypt).
# Generate one locally; never commit a real key:
#   cd backend && uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEYS=
