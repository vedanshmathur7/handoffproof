                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/imports/destination": {
      "post": {
        "tags": [
          "imports and rules"
        ],
        "summary": "Upload Destination",
        "operationId": "upload_destination_api_v1_imports_destination_post",
